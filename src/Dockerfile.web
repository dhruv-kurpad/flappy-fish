# Build context must be ./src (same as docker-compose):
#   docker build -f Dockerfile.web -t flask-api .
# From project root:
#   docker build -f src/Dockerfile.web -t flask-api ./src

FROM python:3.12-slim-bookworm

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir \
    "flask>=3.0.0" \
    "supabase>=2.0.0" \
    "python-dotenv>=1.0.0" \
    gunicorn

COPY flaskapp_pool.py ./

ENV PORT=5000
EXPOSE 5000

CMD ["gunicorn", "-b", "0.0.0.0:5000", "-w", "2", "flaskapp_pool:app"]
